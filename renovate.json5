{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  description: 'Ploeg\'s whole Renovate policy, with no shared preset. Minor, patch, digest and pin updates share one branch that merges itself on green after a release-age soak; security fixes and lock-file maintenance merge themselves; majors, Go toolchain minors and the rules below that ask for one wait for a dashboard tick. A pull request opens as soon as its branch is pushed, because CI runs only on pull requests and never on a renovate/* branch. platformAutomerge hands a green automerging pull request to GitHub auto-merge.',
  extends: ['config:recommended', 'abandonments:recommended', 'mergeConfidence:all-badges'],
  configMigration: true,
  enabled: true,
  timezone: 'Europe/Amsterdam',
  schedule: ['at any time'],
  updateNotScheduled: false,
  fetchChangeLogs: 'pr',
  rebaseWhen: 'conflicted',
  recreateWhen: 'always',
  rangeStrategy: 'pin',
  pinDigests: true,
  separateMajorMinor: true,
  separateMinorPatch: false,
  separateMultipleMajor: true,
  constraintsFiltering: 'strict',
  ignoreUnstable: true,
  respectLatest: true,
  rollbackPrs: true,
  internalChecksFilter: 'strict',
  prCreation: 'immediate',
  prHourlyLimit: 0,
  prConcurrentLimit: 5,
  branchConcurrentLimit: 10,
  suppressNotifications: ['prIgnoreNotification'],
  labels: ['dependencies', 'renovate'],
  semanticCommits: 'enabled',
  semanticCommitType: 'chore',
  semanticCommitScope: 'deps',
  automerge: false,
  platformAutomerge: true,
  assigneesFromCodeOwners: true,
  reviewersFromCodeOwners: true,
  dependencyDashboard: true,
  dependencyDashboardTitle: 'Renovate Dependency Dashboard',
  dependencyDashboardAutoclose: true,
  dependencyDashboardOSVVulnerabilitySummary: 'unresolved',
  osvVulnerabilityAlerts: true,
  prBodyColumns: ['Package', 'Type', 'Update', 'Change', 'Released', 'Age (d)'],
  prBodyDefinitions: {
    Released: '{{#if releaseTimestamp}}{{{releaseTimestamp}}}{{else}}—{{/if}}',
    'Age (d)': '{{#if newVersionAgeInDays}}{{{newVersionAgeInDays}}}d{{else}}—{{/if}}',
  },
  prBodyNotes: [
    '{{#if isMajor}}⚠️ **Major update**: review upstream migration notes and rollout impact before merging.{{/if}}',
    '{{#if isVulnerabilityAlert}}🔒 **Security update**: prioritize review and verify the vulnerable component is actually deployed.{{/if}}',
    '{{#if isGroup}}📦 **Grouped update**: confirm the group is operationally coherent before merging.{{/if}}',
    'Merge Confidence badges are included where supported — low or neutral confidence warrants a manual impact check before merge.',
    '`Released` is the upstream publish time. `—` means the datasource reports no release timestamp. Docker Hub is the only Docker registry that reports one, so this configuration treats every other Docker registry (ghcr.io, quay.io, dhi.io and registry proxies) as `timestamp-optional`: `minimumReleaseAge` cannot hold those updates back and they are eligible as soon as checks pass. For any other datasource, a missing timestamp holds the update for as long as a soak applies. A real date means the soak is enforced: add this update type\'s `minimumReleaseAge` to `Released` to get the eligibility moment.',
  ],
  postUpdateOptions: ['gomodTidy', 'gomodUpdateImportPaths'],
  vulnerabilityAlerts: {
    description: 'Security fixes bypass the dashboard, open at once and merge themselves the moment verify is green, through GitHub auto-merge, with no soak and no dashboard tick, whatever the update type. This block is the only thing that does so: "vulnerability" is not a valid matchUpdateTypes value, so a packageRule matching on it never fires, and this layer is applied on top of the packageRules. The fix strategy stays lowest on purpose: with automerge, the smallest version that closes the CVE is the one you want, not the newest release.',
    enabled: true,
    labels: ['security', 'dependencies', 'renovate'],
    prCreation: 'immediate',
    schedule: ['at any time'],
    dependencyDashboardApproval: false,
    vulnerabilityFixStrategy: 'lowest',
    automerge: true,
    automergeType: 'pr',
    platformAutomerge: true,
    minimumReleaseAge: '0 days',
  },
  lockFileMaintenance: {
    enabled: true,
    extends: ['schedule:monthly'],
    dependencyDashboardApproval: false,
    automerge: true,
    rebaseWhen: 'behind-base-branch',
  },
  postUpgradeTasks: {
    description: 'docs/cncf/license-inventory.yaml and THIRD-PARTY-NOTICES record every shipped module, base image and chart image with its licence, and go test ./internal/licenses/ fails verify when a bump leaves them stale. Renovate regenerates both in the branch, so a dependency update arrives with its inventory already current. The homelab Renovate job allows exactly this script.',
    commands: ['./scripts/update-license-inventory.sh'],
    fileFilters: ['docs/cncf/license-inventory.yaml', 'THIRD-PARTY-NOTICES'],
    executionMode: 'branch',
  },
  pip_requirements: {
    description: 'The agent image\'s openhands-overrides.txt is a requirements file by another name: each line raises one OpenHands dependency above the CLI release\'s lockfile, so each gets update pull requests like any other pin (ops/docker/agent-runner/README.md).',
    managerFilePatterns: ['/(^|/)openhands-overrides\\.txt$/'],
  },
  customManagers: [
    {
      description: 'Versions pinned in workflow env with a `# renovate:` line above them, such as RELEASE_CONFIG_VERSION.',
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/[^/]+\\.ya?ml$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?\\s*\\n\\s*[A-Z0-9_]+:\\s*["\']?(?<currentValue>[^"\'\\s]+)',
      ],
    },
    {
      description: 'Versions pinned as a Dockerfile ARG with a `# renovate:` line above them, such as PYYAML_VERSION in the agent image. OPENHANDS_VERSION and GOOSE_VERSION carry no such line on purpose: the first is paired with its constraints file and the second with its checksums, so the Agent image pins workflow raises them instead (ops/docker/agent-runner/README.md).',
      customType: 'regex',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\nARG [A-Z0-9_]+=(?<currentValue>\\S+)',
      ],
    },
  ],
  packageRules: [
    {
      description: 'Major updates — major label, plain feat commits: a dependency\'s major is NOT the consuming product\'s major (a `!` here cut ploeg v1.0.0-rc.1 off a postgres image bump, 2026-07-26); semantic-release-config also guards deps-scoped breaking as minor',
      matchUpdateTypes: ['major'],
      semanticCommitType: 'feat',
      commitMessageExtra: '( {{currentVersion}} ➔ {{newVersion}} )',
      addLabels: ['type/major'],
    },
    {
      description: 'Minor updates — fix commits: a dependency\'s minor is not a feature of the consuming product, so it cuts a patch release, the same as a patch update.',
      matchUpdateTypes: ['minor'],
      semanticCommitType: 'fix',
      commitMessageExtra: '( {{currentVersion}} ➔ {{newVersion}} )',
      addLabels: ['type/minor'],
    },
    {
      description: 'Patch updates — fix commits',
      matchUpdateTypes: ['patch'],
      semanticCommitType: 'fix',
      commitMessageExtra: '( {{currentVersion}} ➔ {{newVersion}} )',
      addLabels: ['type/patch'],
    },
    {
      description: 'Digest-only updates — no changelog needed, chore commits',
      matchUpdateTypes: ['digest'],
      semanticCommitType: 'chore',
      commitMessageExtra: '( {{currentDigestShort}} ➔ {{newDigestShort}} )',
      fetchChangeLogs: 'off',
      addLabels: ['type/digest'],
    },
    {
      description: 'Pin Docker image digests',
      matchDatasources: ['docker'],
      pinDigests: true,
      addLabels: ['container'],
    },
    {
      description: 'Pin GitHub Actions to immutable digests and treat workflow updates as CI-only',
      matchManagers: ['github-actions'],
      pinDigests: true,
      semanticCommitType: 'ci',
      semanticCommitScope: 'actions',
      commitMessagePrefix: '{{semanticCommitType}}({{semanticCommitScope}}):',
      addLabels: ['github-actions'],
    },
    {
      description: 'Disable peer dependency updates to avoid range-only churn',
      matchDepTypes: ['peerDependencies'],
      enabled: false,
    },
    {
      description: 'Never digest-pin mise-managed tools. The mise manager cannot write digests into .mise.toml aqua/backend entries — the replace never applies (\'Digest is not updated\') and the single failed dep aborts the whole grouped branch (\'Error updating branch: update failure\' on renovate/mise-tools). Version pins remain enabled.',
      matchManagers: ['mise'],
      matchUpdateTypes: ['pinDigest', 'digest'],
      enabled: false,
      pinDigests: false,
    },
    {
      description: 'Never digest-pin an action\'s version input (`with: version:`, depType uses-with). The value is handed to the action, which cannot take a digest. The digest lookup searches for the tag without its v prefix, fails (\'Could not determine new digest for update\'), and drops the update silently: a repository sat on mise 2026.6.14 while 2026.9.17 shipped.',
      matchManagers: ['github-actions'],
      matchDepTypes: ['uses-with'],
      pinDigests: false,
    },
    {
      description: 'Renovate defaults to minimumReleaseAgeBehaviour timestamp-required, which silently keeps an update without a release timestamp out of every branch for as long as a soak applies. Only Docker Hub reports Docker release timestamps, so images from any other registry were detected and never proposed wherever a rule restores the soak. These registries cannot report a timestamp; the soak is skipped for them because it cannot be measured, not because it is unwanted.',
      matchDatasources: ['docker'],
      matchPackageNames: ['/^[^/]+\\.[^/]+\\//', '!/^(docker\\.io|index\\.docker\\.io|registry-1\\.docker\\.io)\\//'],
      minimumReleaseAgeBehaviour: 'timestamp-optional',
    },
    {
      description: 'Require explicit dashboard approval for all normal updates',
      matchUpdateTypes: ['major', 'minor', 'patch', 'pin', 'digest', 'replacement', 'rollback'],
      dependencyDashboardApproval: true,
    },
    {
      description: 'Docker updates wait for a tick, digest pins included.',
      matchDatasources: ['docker'],
      dependencyDashboardApproval: true,
    },
    {
      description: 'CI action updates wait for a tick, digest pins included.',
      matchManagers: ['github-actions'],
      dependencyDashboardApproval: true,
    },
    {
      description: 'The tick is the gate, so ticked update types carry no release-age soak; the non-major rules below restore it where they lift the tick.',
      matchUpdateTypes: ['major', 'minor', 'patch', 'pin', 'digest', 'replacement', 'rollback'],
      minimumReleaseAge: '0 days',
    },
    {
      description: 'Indirect Go modules share one branch. The indirect-module rule below enables them; this rule only decides where they land.',
      matchManagers: ['gomod'],
      matchDepTypes: ['indirect'],
      groupName: 'Go indirect modules',
      groupSlug: 'go-indirect',
    },
    {
      description: 'golang.org/x modules share one branch whether they are direct or indirect. They cut releases in lockstep, share go.sum entries, and `go mod tidy` resolves them together, so one pull request per module only rebases the others for no review value.',
      matchManagers: ['gomod'],
      matchPackageNames: ['golang.org/x/**'],
      groupName: 'golang.org/x modules',
      groupSlug: 'golang-x',
    },
    {
      description: 'Manage indirect Go modules. Renovate disables `// indirect` requirements by default, but Go\'s minimal version selection makes the version written in go.mod the exact source that links into the binary — an unmanaged indirect is an unpatched indirect, and neither osvVulnerabilityAlerts nor vulnerabilityAlerts fire for a dependency that was never looked up. Ploeg shipped golang.org/x/text v0.29.0 (CVE-2026-56852, High) in ploegd 0.2.0-rc.10 for exactly this reason: Trivy saw it in the image, Renovate never had it in scope.',
      matchManagers: ['gomod'],
      matchDepTypes: ['indirect'],
      enabled: true,
      addLabels: ['go'],
    },
    {
      description: 'Label golang.org/x modules as Go modules whether they are direct or indirect requirements. The group rules above group them, because they release in lockstep and share go.sum entries.',
      matchManagers: ['gomod'],
      matchPackageNames: ['golang.org/x/**'],
      addLabels: ['go'],
    },
    {
      description: 'Label and scope Go toolchain moves so they are not mistaken for library bumps. The `go` directive stays on Renovate\'s default (no updates proposed): it is a minimum-compatibility floor, and raising it drops support for older toolchains — a deliberate human decision, not a dependency bump. The `toolchain` directive does get proposals, and lands as chore(go).',
      matchManagers: ['gomod'],
      matchDepTypes: ['golang', 'toolchain'],
      semanticCommitType: 'chore',
      semanticCommitScope: 'go',
      commitMessagePrefix: '{{semanticCommitType}}({{semanticCommitScope}}):',
      addLabels: ['go-toolchain'],
    },
    {
      description: 'Treat the golang builder image the same way: a Dockerfile FROM golang:X is a toolchain move, and it is the one that decides what actually compiles the shipped binary.',
      matchDatasources: ['docker'],
      matchPackageNames: ['golang', 'docker.io/golang', '**/golang'],
      addLabels: ['go-toolchain'],
    },
    {
      description: 'Minor, patch and pin updates share one branch and open without a dashboard tick. One pull request per run instead of one per dependency: every open branch costs a CI run each time it is rebased. A branch that waits for a person rebases only on a conflict: with behind-base-branch every push to the base branch would rebase it and rerun its CI. Branches that merge themselves set behind-base-branch, because a red result from an old base would otherwise keep them from merging forever.',
      matchUpdateTypes: ['minor', 'patch', 'pin'],
      groupName: 'all non-major dependencies',
      groupSlug: 'all-non-major',
      dependencyDashboardApproval: false,
    },
    {
      description: 'Without the tick the soak returns, so a freshly published release is not proposed the hour it appears.',
      matchUpdateTypes: ['minor'],
      minimumReleaseAge: '3 days',
    },
    {
      description: 'Patch soak without the tick.',
      matchUpdateTypes: ['patch'],
      minimumReleaseAge: '1 day',
    },
    {
      description: 'Non-major updates share one branch and merge themselves once its checks are green. One grouped branch per run instead of one per dependency: every open branch costs a full CI run each time it is rebased, and a small runner pool cannot absorb twenty of them per push. The branch rebases when it falls behind, at most once per Renovate run.',
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin', 'pinDigest'],
      groupName: 'all non-major dependencies',
      groupSlug: 'all-non-major',
      dependencyDashboardApproval: false,
      automerge: true,
      automergeType: 'pr',
      addLabels: ['automerge'],
      rebaseWhen: 'behind-base-branch',
    },
    {
      description: 'With minor and patch combined, Renovate offers only the highest non-major Go version, a minor that waits for approval, so the toolchain patch would never be proposed. Go keeps them apart.',
      separateMinorPatch: true,
      matchDepNames: ['go', 'golang', 'docker.io/golang', '**/golang'],
    },
    {
      description: 'A Go toolchain minor decides what compiles the shipped binaries and raises the floor for contributors. It stays a deliberate, dashboard-approved change outside the group; toolchain patches still merge themselves. The tick is its gate, so it carries no soak: a tick on an update still inside its soak is discarded.',
      matchUpdateTypes: ['minor'],
      groupName: null,
      groupSlug: null,
      automerge: false,
      dependencyDashboardApproval: true,
      matchDepNames: ['go', 'golang', 'docker.io/golang', '**/golang'],
      minimumReleaseAge: '0 days',
    },
    {
      description: 'Go toolchain patches merge themselves in their own branch: kept apart from minors, they cannot share the non-major group\'s branch.',
      matchUpdateTypes: ['patch'],
      groupName: 'Go toolchain patches',
      groupSlug: 'go-toolchain-patches',
      matchDepNames: ['go', 'golang', 'docker.io/golang', '**/golang'],
      rebaseWhen: 'behind-base-branch',
    },
    {
      description: 'constraintsFiltering strict above filters releases by constraints. For Go modules Renovate compares the repository\'s `go` directive with each release\'s as exact versions, though both are minimums, so every release that declares a different Go version is dropped. On 2026-10-18 that hid every golang.org/x/time release from v0.4.0 to v0.15.0 and offered rollbacks to v0.3.0 and lib/pq v1.5.2. Go\'s minimal version selection already resolves the toolchain floor, and `go mod tidy` in the branch fails if a release needs a newer one.',
      matchManagers: ['gomod'],
      constraintsFiltering: 'none',
    },
    {
      description: 'The release train owns Ploeg\'s own images and chart: semantic-release writes Chart.yaml version and appVersion, and image.tag follows appVersion. Renovate never proposes them.',
      matchPackageNames: ['ghcr.io/ploeg-hq/**'],
      enabled: false,
    },
    {
      description: 'The npm manifest under .mise/locks is mise\'s own install lock for the openspec CLI, not a project dependency. The tool is bumped through mise.toml.',
      matchFileNames: ['.mise/**'],
      enabled: false,
    },
    {
      description: 'An image in the chart\'s values.yaml (the privileged DinD sidecar) changes the golden renders and the generated configuration reference, so verify fails until `scripts/helm-golden.sh update` is run and its diff reviewed. It gets its own branch behind a dashboard tick instead of holding the non-major group red.',
      matchManagers: ['helm-values'],
      groupName: null,
      groupSlug: null,
      automerge: false,
      dependencyDashboardApproval: true,
    },
    {
      description: 'The semantic-release toolchain image only runs after a merge to development, so verify on the pull request never exercises it. A bump waits for a dashboard tick and lands as ci(release), which cuts no candidate. A major is not split from minors and patches: the update offers the newest release in one pull request.',
      matchPackageNames: ['ghcr.io/webgrip/semantic-release'],
      groupName: null,
      groupSlug: null,
      automerge: false,
      dependencyDashboardApproval: true,
      separateMajorMinor: false,
      semanticCommitType: 'ci',
      semanticCommitScope: 'release',
    },
  ],
}
