{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webgrip.dev/ploeg/contracts/tracker-execution.v1.schema.json",
  "title": "Canonical tracker execution binding v1",
  "description": "Additive source expectations for operator admission. Lookup is scoped by the named bearer consumer. Every native expectation is compared before adopting an existing queued, pristine assignment Work Item. expectedBaseUrl is only compared with the configured singleton provider, never used as an outbound endpoint.",
  "oneOf": [
    {
      "$ref": "#/$defs/lookup"
    },
    {
      "$ref": "#/$defs/source"
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workItemId",
        "provider",
        "externalId",
        "expectedScope",
        "expectedBaseUrl",
        "expectedRevision",
        "expectedUpdatedAt",
        "expectedTarget"
      ],
      "properties": {
        "workItemId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "provider": {
          "$ref": "#/$defs/name"
        },
        "externalId": {
          "$ref": "#/$defs/name"
        },
        "expectedScope": {
          "$ref": "#/$defs/name"
        },
        "expectedBaseUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "format": "uri"
        },
        "expectedRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "expectedUpdatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expectedTarget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "forge",
            "owner",
            "repo",
            "baseBranch"
          ],
          "properties": {
            "forge": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "repo": {
              "type": "string",
              "minLength": 1
            },
            "baseBranch": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "lookup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "item",
        "source"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "item": {
          "$ref": "#/$defs/item"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "externalId",
        "revision",
        "team",
        "state",
        "title",
        "description",
        "url",
        "priority",
        "attempts",
        "infraFailures",
        "nextEligibleAt",
        "createdAt",
        "updatedAt",
        "target",
        "latestShift",
        "lease"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "provider": {
          "type": "string"
        },
        "externalId": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "team": {
          "type": "string"
        },
        "state": {
          "enum": [
            "ingested",
            "proposed",
            "queued",
            "active",
            "leased",
            "needs_human",
            "awaiting_review",
            "stale",
            "done",
            "withdrawn"
          ],
          "description": "The Work Item's lifecycle position. active means a Team is working it (ADR-0093). leased is the retired name of active: Ploeg no longer emits it since ADR-0093 and keeps it in this enum only so a consumer's validation of older payloads holds; the state filter still accepts it as active until the deprecated forms are removed."
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "priority": {
          "type": "integer"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "infraFailures": {
          "type": "integer",
          "minimum": 0
        },
        "nextEligibleAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/target"
            },
            {
              "type": "null"
            }
          ]
        },
        "pullRequest": {
          "anyOf": [
            {
              "$ref": "#/$defs/pullRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "latestShift": {
          "anyOf": [
            {
              "$ref": "#/$defs/shift"
            },
            {
              "type": "null"
            }
          ]
        },
        "lease": {
          "anyOf": [
            {
              "$ref": "#/$defs/lease"
            },
            {
              "type": "null"
            }
          ]
        },
        "waitingFor": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/dependency"
          },
          "description": "The tracker items this Work Item waits for that are not done, as its tracker last reported them (ADR-0123). While it lists any, a queued Work Item gets no Shift; the hold ends when the tracker marks each one done. Optional: absent from older Ploeg releases."
        },
        "premiseCheck": {
          "anyOf": [
            {
              "$ref": "#/$defs/premiseCheck"
            },
            {
              "type": "null"
            }
          ],
          "description": "The Work Item's premise check before its first writer (ADR-0123); null when its Team runs none or it has not run yet. Optional: absent from older Ploeg releases."
        }
      }
    },
    "shift": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "workItemId",
        "team",
        "branch",
        "round",
        "budgetUsd",
        "spentUsd",
        "reservedUsd",
        "openedAt",
        "closedAt",
        "closeReason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "workItemId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "team": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "round": {
          "type": "integer",
          "minimum": 0
        },
        "budgetUsd": {
          "type": "number"
        },
        "spentUsd": {
          "type": "number"
        },
        "heldUsd": {
          "type": "number",
          "description": "The Hold: budget the Shift's unsettled Runs still hold against its pool (ADR-0012, ADR-0093). Always present since ADR-0093; an older Ploeg sends only reservedUsd."
        },
        "reservedUsd": {
          "type": "number",
          "deprecated": true,
          "description": "Deprecated alias of heldUsd, always equal to it (ADR-0093). It is removed from v1 once the deprecation window closes; read heldUsd."
        },
        "openedAt": {
          "type": "string",
          "format": "date-time"
        },
        "closedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "closeReason": {
          "type": "string"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forge",
        "owner",
        "repo",
        "baseBranch"
      ],
      "properties": {
        "forge": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "baseBranch": {
          "type": "string"
        }
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expiresAt",
        "renewedAt"
      ],
      "properties": {
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "renewedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "pullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "agentVerdict",
        "agentVerdictRound",
        "humanChangesRequested",
        "repairFollowUps"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "agentVerdict": {
          "type": "string"
        },
        "agentVerdictRound": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "humanChangesRequested": {
          "type": "boolean"
        },
        "repairFollowUps": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "description": "One open tracker dependency of a Work Item (ADR-0123).",
      "required": [
        "provider",
        "externalId",
        "title",
        "kind",
        "workItemId",
        "firstSeenAt",
        "checkedAt"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "externalId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "description": "Tracker text; untrusted."
        },
        "kind": {
          "enum": [
            "blocked_by",
            "follows"
          ],
          "description": "blocked_by: the tracker says this Work Item is blocked by it. follows: the tracker says this Work Item follows it."
        },
        "workItemId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Ploeg's Work Item for the same tracker item, or null when Ploeg has none."
        },
        "firstSeenAt": {
          "type": "string",
          "format": "date-time"
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When Ploeg last read the tracker's dependencies of this Work Item."
        }
      }
    },
    "premiseCheck": {
      "type": "object",
      "additionalProperties": false,
      "description": "A Work Item's premise check (ADR-0123): one classifier call on a gateway model priced at zero, before the first writer. proceed opens the Shift; ask and too_big move the Work Item to needs_human with the question and spend nothing on a writer; skipped means the check gave up and dispatch went on. A person assigning or requeuing the Work Item again sends it on without a second check.",
      "required": [
        "verdict",
        "question",
        "reason",
        "model",
        "attempts",
        "checkedAt"
      ],
      "properties": {
        "verdict": {
          "anyOf": [
            {
              "enum": [
                "proceed",
                "ask",
                "too_big",
                "skipped"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Null while every attempt so far failed without an answer."
        },
        "question": {
          "type": "string",
          "description": "What a person must answer (ask) or a suggested split (too_big); empty otherwise. Model output about tracker text; untrusted."
        },
        "reason": {
          "type": "string",
          "description": "One line on why, or the last failure for skipped. Untrusted."
        },
        "model": {
          "type": "string"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "checkedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
