{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ploeg chart values",
  "type": "object",
  "properties": {
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string",
              "pattern": "^([0-9]+(ms|s|m|h|d|w|y))+$"
            },
            "scrapeTimeout": {
              "type": "string",
              "pattern": "^([0-9]+(ms|s|m|h|d|w|y))+$"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "prometheusRule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "selector": {
              "type": "string",
              "description": "PromQL label matchers applied to every alert; empty = job and namespace of this release"
            },
            "runbookBaseUrl": {
              "type": "string",
              "description": "URL of the rendered alerts page; each alert appends its anchor"
            },
            "alerts": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "stuckShift": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "idleHours": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "for": {
                      "type": "string",
                      "pattern": "^([0-9]+(ms|s|m|h|d|w|y))+$"
                    },
                    "severity": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "expiredLease": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "overdueSeconds": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "for": {
                      "type": "string",
                      "pattern": "^([0-9]+(ms|s|m|h|d|w|y))+$"
                    },
                    "severity": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "leakedModelKey": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "graceSeconds": {
                      "type": "number",
                      "minimum": 0
                    },
                    "for": {
                      "type": "string",
                      "pattern": "^([0-9]+(ms|s|m|h|d|w|y))+$"
                    },
                    "severity": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "spendSpike": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "usdPerHour": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "for": {
                      "type": "string",
                      "pattern": "^([0-9]+(ms|s|m|h|d|w|y))+$"
                    },
                    "severity": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "trackerWebhookMissing": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "for": {
                      "type": "string",
                      "pattern": "^([0-9]+(ms|s|m|h|d|w|y))+$"
                    },
                    "severity": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "deploys": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokenSecret": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "key"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9._-]+$"
            }
          }
        }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "consumers": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "tokenSecret"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "teams": {
                "type": "array",
                "maxItems": 100,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                }
              },
              "execute": {
                "type": "boolean"
              },
              "maxBudgetUsd": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 10000
              },
              "tokenSecret": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "key"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^[A-Za-z0-9._-]+$"
                  }
                }
              },
              "verify": {
                "type": "boolean"
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "maxBudgetUsd"
                  ]
                },
                "then": {
                  "required": [
                    "execute"
                  ],
                  "properties": {
                    "execute": {
                      "const": true
                    }
                  }
                }
              }
            ]
          }
        },
        "deliveryPolicies": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repositoryId",
              "policySha256",
              "verifierId",
              "minTests"
            ],
            "properties": {
              "repositoryId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "policySha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "verifierId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "minTests": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "publicationEnabled": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "executor": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "enum": [
            "keda",
            "cronjob",
            "sandbox"
          ]
        },
        "harness": {
          "$ref": "#/definitions/harness"
        },
        "runnerImage": {
          "type": "string"
        },
        "dindImage": {
          "type": "string"
        },
        "workerImage": {
          "type": "string"
        },
        "apiUrl": {
          "type": "string"
        },
        "cronjob": {
          "type": "object",
          "properties": {
            "schedule": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "defaultTarget": {
          "type": "object",
          "description": "fallback repo for teams that declare none; empty = a team with no repoOwner/repoName gets no env target and relies entirely on the work item's resolved target",
          "properties": {
            "owner": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "baseBranch": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "teams": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "budget": {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]+)?$"
              },
              "perRunBudget": {
                "//": "Per-run key ceiling for a team with no plan. Optional; falls back to budget, which for a PLANNED team is the Shift pool and not a per-run figure.",
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]+)?$"
              },
              "repoOwner": {
                "type": "string",
                "minLength": 1
              },
              "repoName": {
                "type": "string",
                "minLength": 1
              },
              "baseBranch": {
                "type": "string"
              },
              "targetSource": {
                "enum": [
                  "claim",
                  "env"
                ]
              },
              "maxReplicaCount": {
                "type": "integer",
                "minimum": 1
              },
              "maxRunning": {
                "type": "integer",
                "minimum": 0,
                "description": "Concurrency cap: the most Runs this team may have running at once, enforced by ploegd at claim time. A claim over the cap gets no work and the worker exits 0. Every workload's maxReplicaCount is clamped to it. 0 or unset = unlimited."
              },
              "harness": {
                "$ref": "#/definitions/harness"
              },
              "sandbox": {
                "$ref": "#/definitions/sandboxOverride"
              },
              "plan": {
                "type": "array",
                "minItems": 1,
                "description": "ordered Rounds of a Shift (run-multi-agent-shifts): each round a reader fan-out or one writer. A team with a plan runs multi-role; without one, dispatch is unchanged. budget doubles as the Shift pool.",
                "items": {
                  "type": "object",
                  "properties": {
                    "roles": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "$ref": "#/definitions/planRole"
                      }
                    }
                  },
                  "required": [
                    "roles"
                  ],
                  "additionalProperties": false
                }
              },
              "maxFixRounds": {
                "type": "integer",
                "minimum": 0,
                "description": "ADR-0017: how many times a reviewer request_changes may re-open the writing Round of this plan. 0 = loop off, the plan runs to exhaustion."
              },
              "executorType": {
                "type": "string",
                "enum": ["keda", "sandbox"],
                "description": "Optional: this team's executor while executor.type is keda or sandbox; unset = executor.type. Lets one team run under the experimental sandbox executor while the others stay on keda."
              }
            },
            "//": "repoOwner/repoName are NOT required: the repository belongs to the work item, resolved at ingest (R11). They remain as a per-team fallback while teams migrate.",
            "required": [
              "name",
              "model",
              "budget"
            ],
            "additionalProperties": false
          }
        },
        "forge": {
          "type": "string",
          "enum": [
            "forgejo",
            "gitlab"
          ],
          "description": "Which forge the workers act against; selects the sibling block of the same name. Also the default dialect for a Work Item whose target names no forge (ADR-0023). One active forge per release: a worker pod holds one forge URL and one credential."
        },
        "gitlab": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "url": {
              "type": "string",
              "description": "Base URL, no /api/v4. Empty = ploegd configures no GitLab provider, so findings never reach a merge request."
            },
            "publicUrl": {
              "type": "string",
              "description": "ploegd's GitLab URL when it differs from the workers' url. Empty = url."
            },
            "tokenSecret": {
              "$ref": "#/definitions/secretRef",
              "description": "Token with api scope on the target projects, sent as PRIVATE-TOKEN. ADR-0013 tier 2 does not apply on GitLab: per-run push credentials are minted through a Forgejo admin endpoint with no GitLab equivalent, so this shared token is what writing Runs use."
            },
            "readTokenSecret": {
              "$ref": "#/definitions/readTokenSecretRef",
              "description": "ADR-0013 tier 1, as for forgejo: a read-only credential for reading Roles, so the reader/writer split is enforced at the forge and not only by scheduling. On GitLab a second project access token at read_repository scope. Required (name and key) when any team has a reading Role: the render fails without it rather than hand readers the read-write token."
            },
            "webhookSecret": {
              "$ref": "#/definitions/secretRef",
              "description": "Shared secret GitLab sends as X-Gitlab-Token to POST /webhooks/forge/gitlab. Unset = every forge webhook is rejected."
            }
          }
        },
        "forgejo": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "url": {
              "type": "string",
              "description": "The workers' forge URL (FORGE_URL): clone, push, pull-request API and the forge proxy upstream. An in-cluster URL keeps Run traffic off the public gateway. Required when the executor is enabled on this forge; empty with the executor off = ploegd has no forge provider."
            },
            "publicUrl": {
              "type": "string",
              "description": "ploegd's forge URL (PLOEG_FORGEJO_URL). Empty = url. Set it to the public https URL when url is in-cluster: ploegd matches Vloer's https repository URLs against it and accepts only https or ssh ones."
            },
            "tokenSecret": {
              "$ref": "#/definitions/secretRef"
            },
            "readTokenSecret": {
              "$ref": "#/definitions/readTokenSecretRef",
              "description": "ADR-0013 tier 1: read-only credential for reading Roles. Required (name and key) when any team has a reading Role: the render fails without it rather than hand readers the read-write builder token."
            },
            "botPasswordSecret": {
              "$ref": "#/definitions/secretRef",
              "description": "ADR-0013 tier 2: the password of botUser, which ploegd uses to MINT per-run push tokens limited to the Run's repository. Held only by ploegd, never by a worker. Unset = nothing is minted."
            },
            "botUser": {
              "type": "string",
              "description": "the forge user whose tokens are minted (default agent-builder)"
            },
            "webhookSecret": {
              "$ref": "#/definitions/secretRef",
              "description": "HMAC secret that verifies X-Forgejo-Signature on POST /webhooks/forge/forgejo. Unset = every forge webhook is rejected: merges are still found by the periodic pull request reconcile, but human reviews and failed checks never reach Ploeg."
            }
          },
          "additionalProperties": true
        },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "description": "Worker pods ServiceAccount. create and name are independent: naming an account never suppresses creating it."
        },
        "nodeSelector": {
          "type": [
            "object",
            "null"
          ],
          "description": "Node selector for WORKER pods, not ploegd (that is the top-level nodeSelector). Empty by default, so workers schedule on any node. Set your own label to keep agent Jobs and their privileged DinD sidecar off control-plane nodes (ADR-0002: no DinD beside etcd).",
          "additionalProperties": {
            "type": "string"
          }
        },
        "workerAuth": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "managed",
                "legacy"
              ]
            },
            "signingKeySecret": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "name",
                "key"
              ],
              "additionalProperties": false
            },
            "bootstrapSecret": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "registryKey": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "name",
                "registryKey"
              ],
              "additionalProperties": false
            },
            "staticInferenceSecret": {
              "oneOf": [
                {
                  "type": "object",
                  "maxProperties": 0
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "key": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "name",
                    "key"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "additionalLLMPolicies": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "team": {
                    "type": "string",
                    "minLength": 1
                  },
                  "role": {
                    "type": "string"
                  },
                  "budgetUsd": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "models": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "ttl": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "team",
                  "role",
                  "budgetUsd",
                  "models",
                  "ttl"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "mode",
            "signingKeySecret",
            "bootstrapSecret"
          ],
          "additionalProperties": false
        },
        "forgeTokenIsolation": {
          "enum": [
            "",
            "proxy"
          ]
        },
        "sandbox": {
          "type": "object",
          "additionalProperties": false,
          "description": "type=sandbox only: runs each Run in a kubernetes-sigs/agent-sandbox v1beta1 Sandbox created by a launcher pod.",
          "properties": {
            "runtimeClassName": {
              "type": "string"
            },
            "ttlSecondsAfterFinished": {
              "type": "integer",
              "minimum": 0
            },
            "shutdownMarginSeconds": {
              "type": "integer",
              "minimum": 60
            },
            "startTimeoutSeconds": {
              "type": "integer",
              "minimum": 60
            },
            "networkPolicy": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ingress": {
                  "type": "array"
                },
                "egress": {
                  "type": "array"
                }
              }
            },
            "launcherResources": {
              "type": "object"
            }
          }
        }
      }
    },
    "tracker": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "tokenSecret": {
          "$ref": "#/definitions/secretRef"
        },
        "clickup": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "url": {
              "type": "string",
              "description": "ClickUp API root; empty = https://api.clickup.com/api/v2"
            },
            "tokenSecret": {
              "$ref": "#/definitions/secretRef",
              "description": "Personal token (pk_\u2026) for reads and write-backs. Empty = the provider logs and no-ops instead of failing runs."
            },
            "webhookSecret": {
              "$ref": "#/definitions/secretRef",
              "description": "Verifies X-Signature on POST /webhooks/tracker/clickup. ClickUp generates this on webhook registration \u2014 capture it, never invent it. Empty = deliveries are rejected."
            },
            "doneStatus": {
              "type": "string",
              "description": "List status name applied when a Shift finishes, e.g. 'for review'. Statuses are per-List custom strings; empty leaves the board untouched."
            }
          }
        }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "description": "ploegd's routing and roster as a file (mounted at /etc/ploeg/ploeg.yaml). Projects are NAMED and resolved to tracker ids at boot, so no magic numbers live in cluster config. `targets:` registers repositories a `repo/<key>` label may select, and a project's `default:`/`allow:` name them (ADR-0038). A project's `gates:` maps its statuses or bucket titles to the delivery gates development, test, acceptance and done (ADR-0051). A team's `cards:` names the people who referee its disputed cracks and the labels that mark a hotfix (ADR-0052), and `prComment: true` keeps one card comment with the card image on its merged pull requests (ADR-0055). A target's or project's `rarity:` sets the Run card rarity path rules: `attentionPaths` add sensitive ground, `sensitivePaths` and `sizeExclude` replace the defaults (ADR-0056). A project with `gates:` or `statusKinds:` records every tracker status move, and `statusKinds:` sorts its statuses into active, waiting, blocked and done for the Run card's flow figures; a team's `workingHours:` (timezone, days, start, end, holidays) is the calendar their working seconds count in, Monday to Friday 09:00 to 17:00 Europe/Amsterdam by default (ADR-0057). A target's or project's `cardShape:` sets which files a Run card counts as tests (`testPaths`) and documentation (`docPaths`), each replacing its defaults (ADR-0058). Empty = the legacy PLOEG_TARGET_MAP/PLOEG_TEAM_MAP/PLOEG_TEAM_PLANS env vars still apply."
    }
  },
  "definitions": {
    "sandboxOverride": {
      "type": "object",
      "description": "type=sandbox only: overrides executor.sandbox for one team's or Role's SandboxTemplate, field by field. An unset field falls back to the team, then the global block.",
      "additionalProperties": false,
      "properties": {
        "runtimeClassName": {
          "type": "string",
          "description": "RuntimeClass for the agent-sandbox pod; empty = fall back to the team, then executor.sandbox.runtimeClassName."
        }
      }
    },
    "planRole": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "writes": {
          "type": "boolean"
        },
        "planner": {
          "type": "boolean",
          "description": "ADR-0031: the Role splits or clarifies its Work Item and returns createdWorkItems instead of code. A planner never writes."
        },
        "cap": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "maxReplicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "harness": {
          "$ref": "#/definitions/harness"
        },
        "sandbox": {
          "$ref": "#/definitions/sandboxOverride"
        },
        "workerResources": {
          "type": "object",
          "description": "Overrides executor.workerResources for this role's workload. Readers do not build, so a fan-out round need not book writer-sized pods."
        },
        "dindResources": {
          "type": "object",
          "description": "Overrides executor.dindResources for this role's DinD sidecar (only rendered when the role runs harness.dind)."
        }
      },
      "//": "name becomes the workload suffix (ploeg-worker-<team>-<role>); writes marks the round's single writer (ADR-0010); cap bounds one Run's spend against the pool (ADR-0012); model/maxReplicaCount/harness override the team's values for this role's workload.",
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "harness": {
      "type": "object",
      "properties": {
        "name": {
          "enum": [
            "openhands",
            "exec",
            "claude-code",
            "acp"
          ]
        },
        "image": {
          "type": "string"
        },
        "entrypoint": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outcomeFile": {
          "type": "string"
        },
        "dind": {
          "type": "boolean"
        },
        "timeout": {
          "type": "string",
          "pattern": "^$|^0$|^[0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h)$"
        },
        "idleTimeout": {
          "type": "string",
          "pattern": "^$|^0$|^[0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h)$"
        },
        "acp": {
          "$ref": "#/definitions/acp"
        },
        "toolchains": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/toolchain"
          }
        },
        "verify": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\n\\r]+$"
          }
        },
        "verifyTimeout": {
          "type": "string",
          "pattern": "^$|^0$|^[0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h)$"
        }
      },
      "additionalProperties": false
    },
    "toolchain": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 40
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/[^:]*$"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "image"
      ],
      "additionalProperties": false
    },
    "acp": {
      "type": "object",
      "properties": {
        "profile": {
          "enum": [
            "opencode",
            "qwen-code",
            "goose",
            "openhands",
            "custom"
          ]
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permissionMode": {
          "enum": [
            "",
            "allow_always",
            "allow_read_only",
            "deny_all"
          ]
        },
        "promptTimeout": {
          "type": "string",
          "pattern": "^$|^[0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h)$"
        },
        "idleTimeout": {
          "type": "string",
          "pattern": "^$|^[0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h)$"
        },
        "configJson": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "readTokenSecretRef": {
      "description": "Either empty (no reading Role anywhere) or a complete secretRef. A half-set reference would fail at pod start instead of at render.",
      "allOf": [
        { "$ref": "#/definitions/secretRef" },
        {
          "anyOf": [
            { "type": "object", "maxProperties": 0 },
            { "type": "object", "required": ["name", "key"] }
          ]
        }
      ]
    },
    "secretRef": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
